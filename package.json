{
  "name": "read-tracker-extension",
  "description": "Local-only reading list with read-state badges and custom thumbnails",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && wxt zip",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
